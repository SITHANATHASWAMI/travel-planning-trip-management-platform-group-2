{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://backend-production-8a24f.up.railway.app/api/$1"
    },
    {
      "src": "^/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_BASE_URL": "https://backend-production-8a24f.up.railway.app/api"
  },
  "build": {
    "env": {
      "REACT_APP_API_BASE_URL": "https://backend-production-8a24f.up.railway.app/api"
    }
  }
}